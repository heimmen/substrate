# mf-pi 测试环境（59681）
#
# 本文件由 demos/mf-pi/lib/env.sh 以 `source` 方式加载。

MFPI_ENV_NAME=test

MFPI_NAMESPACE=ate-demo-mf-pi-test
MFPI_ATESPACE=mfpi-test
MFPI_WORKLOAD_LABEL=mf-pi-test

MFPI_ENTRY_PORT=59681
MFPI_ROUTER_PORT=59880
MFPI_ADMIN_PORT=59882
MFPI_CICD_PORT=59690

MFPI_NGINX_CONTAINER=mfpi-nginx-test
MFPI_NGINX_CONF=nginx-test.conf
MFPI_HTPASSWD=/tmp/mfpi-admin-test.htpasswd

MFPI_USER_COOKIE=mfpi_user_test
MFPI_AUTH_COOKIE=mfpi_auth_test

: "${MFPI_WORKER_REPLICAS_BASE:=0}"
: "${MFPI_WORKER_REPLICAS_SMALL:=8}"
: "${MFPI_WORKER_REPLICAS_MID:=0}"
: "${MFPI_WORKER_REPLICAS_LARGE:=0}"

MFPI_DEPLOY_SCRIPT=deploy-test.sh
MFPI_RUN_NGINX_SCRIPT=run-nginx-test.sh
MFPI_STOP_NGINX_SCRIPT=stop-nginx-test.sh
MFPI_CICD_SCRIPT=deploy-test.sh
MFPI_CICD_PIDFILE=/tmp/mfpi-cicd-test.pid
MFPI_CICD_LOG=/tmp/mfpi-cicd-test.log
