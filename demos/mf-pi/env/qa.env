# mf-pi QA 环境（58681）
#
# 注意：本环境沿用历史上的 `mfpi` / `ate-demo-mf-pi` 资源名，这样已有的
# 用户、会话、持久卷和快照不需要迁移（atespace / actor / 卷 ID 都带名字，
# 原地改名会丢数据）。新生产环境使用 `mfpi-prod` / `ate-demo-mf-pi-prod`。
#
# 本文件由 demos/mf-pi/lib/env.sh 以 `source` 方式加载。

MFPI_ENV_NAME=qa

MFPI_NAMESPACE=ate-demo-mf-pi
MFPI_ATESPACE=mfpi
MFPI_WORKLOAD_LABEL=mf-pi

MFPI_ENTRY_PORT=58681
MFPI_ROUTER_PORT=58680
MFPI_ADMIN_PORT=58682
MFPI_CICD_PORT=58690

MFPI_NGINX_CONTAINER=mfpi-nginx-qa
MFPI_NGINX_CONF=nginx-qa.conf
MFPI_HTPASSWD=/tmp/mfpi-admin-qa.htpasswd

MFPI_USER_COOKIE=mfpi_user_qa
MFPI_AUTH_COOKIE=mfpi_auth_qa

: "${MFPI_WORKER_REPLICAS_BASE:=0}"
: "${MFPI_WORKER_REPLICAS_SMALL:=30}"
: "${MFPI_WORKER_REPLICAS_MID:=0}"
: "${MFPI_WORKER_REPLICAS_LARGE:=0}"

MFPI_DEPLOY_SCRIPT=deploy-qa.sh
MFPI_RUN_NGINX_SCRIPT=run-nginx-qa.sh
MFPI_STOP_NGINX_SCRIPT=stop-nginx-qa.sh
MFPI_CICD_SCRIPT=deploy-qa.sh
MFPI_CICD_PIDFILE=/tmp/mfpi-cicd-qa.pid
MFPI_CICD_LOG=/tmp/mfpi-cicd-qa.log
