# mf-pi 生产环境（57681）
#
# 单一事实来源：所有部署/启动脚本都从这里取环境相关常量，避免把端口、
# namespace、atespace、cookie 名散落在几十个脚本里。
#
# 本文件被 demos/mf-pi/lib/env.sh 以 `source` 方式加载，因此只能写
# `KEY=value`（不要用 `local`，不要调用函数）。

MFPI_ENV_NAME=prod

# Kubernetes 资源
MFPI_NAMESPACE=ate-demo-mf-pi-prod
MFPI_ATESPACE=mfpi-prod
# WorkerPool / ActorTemplate 的 workload 标签（集群级匹配，必须每环境不同）
MFPI_WORKLOAD_LABEL=mf-pi-prod

# 宿主机入口端口
MFPI_ENTRY_PORT=57681
MFPI_ROUTER_PORT=57680
MFPI_ADMIN_PORT=57682
MFPI_CICD_PORT=57690

# 宿主机 Docker 网关
MFPI_NGINX_CONTAINER=mfpi-nginx-prod
MFPI_NGINX_CONF=nginx-prod.conf
MFPI_HTPASSWD=/tmp/mfpi-admin-prod.htpasswd

# Cookie 名。Cookie 不区分端口，同宿主上的三个环境必须用不同名字，
# 否则在 qa 登录后浏览器会把 qa 的 cookie 发给 prod。
MFPI_USER_COOKIE=mfpi_user_prod
MFPI_AUTH_COOKIE=mfpi_auth_prod

# 默认资源档位（deploy.sh 可通过同名 env 覆盖）
: "${MFPI_WORKER_REPLICAS_BASE:=0}"
: "${MFPI_WORKER_REPLICAS_SMALL:=8}"
: "${MFPI_WORKER_REPLICAS_MID:=1}"
: "${MFPI_WORKER_REPLICAS_LARGE:=1}"

# 脚本名（供通用 deploy/cicd 逻辑回指）
MFPI_DEPLOY_SCRIPT=deploy-prod.sh
MFPI_RUN_NGINX_SCRIPT=run-nginx-prod.sh
MFPI_STOP_NGINX_SCRIPT=stop-nginx-prod.sh
MFPI_CICD_SCRIPT=deploy-prod.sh
MFPI_CICD_PIDFILE=/tmp/mfpi-cicd-prod.pid
MFPI_CICD_LOG=/tmp/mfpi-cicd-prod.log
