# pi-web deployed as an actor (the mf-pi demo) — TEST environment.
#
# This is the test-environment counterpart of mf-pi.yaml.tmpl. It deploys into
# the ate-demo-mf-pi-test namespace, uses the mfpi-test atespace, a distinct
# worker label (workload=mf-pi-test) and a separate snapshot path so it never
# collides with the production environment. Pause and workload images are
# pinned by digest and must be pushed to ${KO_DOCKER_REPO} (localhost:5001 in
# a kind environment) — the cluster nodes cannot reach external registries.
#
# See mf-pi.yaml.tmpl for why only `args` is set (the image's ENTRYPOINT
# tini -- pi-web-bootstrap is preserved and execs the sessiond+web supervisor).

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-mf-pi-test
---

apiVersion: v1
kind: Secret
metadata:
  name: mf-pi-provider-config
  namespace: ate-demo-mf-pi-test
type: Opaque
stringData:
  # pi-web's built-in deepseek provider picks this up (model picker:
  # deepseek/deepseek-chat or deepseek/deepseek-reasoner).
  DEEPSEEK_API_KEY: "${DEEPSEEK_API_KEY}"
---

# Grant ate-api-server read access to the Secret that this demo's
# ActorTemplate references for env resolution.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ate-api-server-env-sources
  namespace: ate-demo-mf-pi-test
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["mf-pi-provider-config"]
  verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ate-api-server-env-sources
  namespace: ate-demo-mf-pi-test
subjects:
- kind: ServiceAccount
  name: ate-api-server
  namespace: ate-system
roleRef:
  kind: Role
  name: ate-api-server-env-sources
  apiGroup: rbac.authorization.k8s.io
---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: mf-pi-workerpool
  namespace: ate-demo-mf-pi-test
  labels:
    # Distinct worker label from prod (workload=mf-pi): scheduling matches
    # workers by label across the whole cluster, so this keeps test actors on
    # test workers and prod actors on prod workers.
    workload: mf-pi-test
spec:
  # Base (legacy) tier; unused by the demo's users and by the E2E scripts (both
  # target the small tier). Configurable via ${MFPI_WORKER_REPLICAS_BASE}
  # (default 0) so a plain deploy does not spend idle worker pods on it.
  replicas: ${MFPI_WORKER_REPLICAS_BASE}
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: mf-pi-wp-small
  namespace: ate-demo-mf-pi-test
  labels:
    # Distinct worker label from prod (workload=mf-pi): scheduling matches
    # workers by label across the whole cluster, so this keeps test actors on
    # test workers and prod actors on prod workers.
    workload: mf-pi-small-test
spec:
  # Number of physical workers; bounds the max number of concurrently-active
  # (non-suspended) users. Configurable via ${MFPI_WORKER_REPLICAS_SMALL}
  # (default 32), independent of the base/mid/large pools. Must match the
  # production small pool's sizing (mf-pi.yaml.tmpl).
  replicas: ${MFPI_WORKER_REPLICAS_SMALL}
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor

  template:
    resources:
      # requests.cpu is what the scheduler reserves, so it bounds how many
      # workers — i.e. how many concurrently-active users — fit on one node.
      # limits.cpu only caps runtime throttling. Keep the request small and the
      # limit generous: mostly-idle agents pack densely, while an active agent
      # can still burst into capacity the idle workers are not using.
      requests:
        cpu: "250m"
        memory: 1Gi
      limits:
        cpu: "1"
        memory: 1Gi

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: mf-pi-wp-mid
  namespace: ate-demo-mf-pi-test
  labels:
    # Distinct worker label from prod (workload=mf-pi): scheduling matches
    # workers by label across the whole cluster, so this keeps test actors on
    # test workers and prod actors on prod workers.
    workload: mf-pi-mid-test
spec:
  # Number of physical workers; bounds the max number of concurrently-active
  # (non-suspended) users. Configurable via ${MFPI_WORKER_REPLICAS_MID}
  # (default 1). Keep this tiny: each mid worker reserves a whole core and it
  # shares a node with the production pools.
  replicas: ${MFPI_WORKER_REPLICAS_MID}
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor

  template:
    resources:
      requests:
        cpu: "1"
        memory: 2Gi
      limits:
        cpu: "1"
        memory: 2Gi

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: mf-pi-wp-large
  namespace: ate-demo-mf-pi-test
  labels:
    # Distinct worker label from prod (workload=mf-pi): scheduling matches
    # workers by label across the whole cluster, so this keeps test actors on
    # test workers and prod actors on prod workers.
    workload: mf-pi-large-test
spec:
  # Number of physical workers; bounds the max number of concurrently-active
  # (non-suspended) users. Configurable via ${MFPI_WORKER_REPLICAS_LARGE}
  # (default 1). Each large worker reserves two cores; keep it minimal here.
  replicas: ${MFPI_WORKER_REPLICAS_LARGE}
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor

  template:
    resources:
      requests:
        cpu: "2"
        memory: 4Gi
      limits:
        cpu: "2"
        memory: 4Gi
---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: mf-pi
  namespace: ate-demo-mf-pi-test
spec:
  pauseImage: "localhost:5001/pause:3.10.2@${PAUSE_DIGEST}"
  containers:
  - name: mf-agent
    image: "localhost:5001/mf-agent@${MF_PI_DIGEST}"
    # Only `args` is set (no `command`), so the image's ENTRYPOINT
    # (tini -- /usr/local/bin/pi-web-bootstrap) is preserved: the bootstrap
    # installs the baked-in skills into /data/pi-agent/skills on first start
    # and then execs this single-container supervisor (sessiond + web).
    args:
    - sh
    - -c
    - |
      set -eu
      # Put the user's home (and XDG config) on the userdata volume, which is
      # mounted at /data/pi-agent. pi-web installs user-scope Pi packages and
      # skills under $HOME/.pi/packages (POST /api/pi-packages/install), so
      # without this redirection a user-installed skill lives on the ephemeral
      # sandbox rootfs and disappears on every image update (delete +
      # recreate). See docs/persistence_gaps.md. The image's own /data/home is
      # used only as a non-destructive seed source, so any build-time dotfiles
      # there are preserved.
      mkdir -p "$HOME" "${XDG_CONFIG_HOME:-$HOME/.config}"
      if [ -d /data/home ] && [ "$HOME" != /data/home ]; then
        cp -an /data/home/. "$HOME"/ 2>/dev/null || true
      fi

      # Single-container supervisor (sessiond + web). User data lives on
      # the userdata volume mounted at /data/pi-agent (externalVolumeTemplate
      # below): everything the agent writes there is persisted by the sticky
      # volume plugin and survives a delete+recreate redeploy (image refresh),
      # so no profile sync or admin broker is involved
      # (see docs/save_userdata_pv.md).

      # Recover baked-in skills for the same reason. pi-web-bootstrap installs
      # the image's skills (/opt/pi-web/skills) into $PI_CODING_AGENT_DIR/skills
      # on first start only, so a brand-new user resumed from the golden base
      # snapshot never runs that install and starts without skills. Mirror its
      # no-clobber copy here on every pass: missing skills are installed,
      # existing ones are left untouched.
      (
        while true; do
          skills_src=${PI_WEB_IMAGE_SKILLS_DIR:-/opt/pi-web/skills}
          skills_dst=${PI_CODING_AGENT_DIR:-/data/pi-agent}/skills
          if [ -d "$skills_src" ]; then
            mkdir -p "$skills_dst"
            for skill_dir in "$skills_src"/*/; do
              [ -d "$skill_dir" ] || continue
              skill_name=$(basename "$skill_dir")
              if [ ! -e "$skills_dst/$skill_name" ]; then
                cp -a "$skill_dir" "$skills_dst/$skill_name" 2>/dev/null || true
              fi
            done
          fi
          sleep 10
        done
      ) &

      # Pull the administrator-managed provider registry (see
      # admin/providermodels.go). The admin serves a models.json document that
      # adds OpenAI-compatible endpoints beyond pi-web's built-in registry
      # (SiliconFlow, an internal gateway, ...). The platform cannot hand an
      # actor a ConfigMap, so it is pulled over HTTP like managed skills. Only
      # the managed providers are merged in: other keys and providers already in
      # the agent's models.json survive, and a failed fetch or an unparseable
      # body leaves the current file untouched. pi-web re-reads models.json on
      # every request, so a change applies without restarting sessiond/web.
      if [ -n "${PI_WEB_MODELS_URL:-}" ]; then
        (
          while true; do
            node -e '
              const fs = require("fs");
              const path = require("path");
              const url = process.env.PI_WEB_MODELS_URL || "";
              const agentDir = process.env.PI_CODING_AGENT_DIR || "/data/pi-agent";
              const dst = path.join(agentDir, "models.json");
              if (!url) process.exit(0);
              fetch(url, { headers: { accept: "application/json" }, signal: AbortSignal.timeout(20000) })
                .then((res) => {
                  if (!res.ok) throw new Error("HTTP " + res.status);
                  return res.json();
                })
                .then((managed) => {
                  if (!managed || typeof managed !== "object" || !managed.providers) {
                    throw new Error("payload has no providers");
                  }
                  let current = {};
                  try { current = JSON.parse(fs.readFileSync(dst, "utf8")) || {}; } catch (err) {}
                  const merged = Object.assign({}, current, {
                    providers: Object.assign({}, current.providers || {}, managed.providers),
                  });
                  const next = JSON.stringify(merged, null, 2) + "\n";
                  let existing = null;
                  try { existing = fs.readFileSync(dst, "utf8"); } catch (err) {}
                  if (existing !== next) {
                    const tmp = dst + ".tmp";
                    fs.writeFileSync(tmp, next);
                    fs.renameSync(tmp, dst);
                    console.log("provider-models: updated " + dst);
                  }
                })
                .catch((err) => { console.error("provider-models: " + err.message); });
            ' 2>/dev/null || true
            sleep 60
          done
        ) &
      fi
      # Pull administrator-managed skills (see docs/deploy_skill_to_actor.md). The
      # admin is the authoritative source; each actor conditionally syncs the
      # managed skills into $PI_CODING_AGENT_DIR/skills on a 10s cadence,
      # keying on the manifest ETag/version so unchanged skills are not
      # re-downloaded. Only skills the admin has managed are ever touched; a
      # user's own skills are never modified or removed. PI_WEB_SKILLS_URL is
      # the /internal/skills base of the admin service. A network/parse failure
      # is logged and skipped (|| true) so it never blocks sessiond/web.
      (
        while true; do
          if [ -n "${PI_WEB_SKILLS_URL:-}" ]; then
            node -e '
              const zlib = require("zlib");
              const fs = require("fs");
              const path = require("path");
              const base = process.env.PI_WEB_SKILLS_URL || "";
              const agentDir = process.env.PI_CODING_AGENT_DIR || "/data/pi-agent";
              const dst = path.join(agentDir, "skills");
              const statePath = path.join(agentDir, ".mfpi-managed-skills.json");
              const log = (...a) => console.log("mfpi-skills:", ...a);
              const readState = () => {
                try { return JSON.parse(fs.readFileSync(statePath, "utf8")); }
                catch (e) { return { version: "", managed: {} }; }
              };
              const writeState = (obj) => {
                fs.mkdirSync(agentDir, { recursive: true });
                const tmp = statePath + ".tmp";
                fs.writeFileSync(tmp, JSON.stringify(obj));
                fs.renameSync(tmp, statePath);
              };
              // Pure-node ustar .tar.gz extractor. Do not spawn the GNU `tar`
              // binary from the gVisor sandbox: it fails to create subdirectory
              // entries there with ENOSYS ("Function not implemented"). Use
              // built-in zlib + a minimal ustar parser instead.
              const oct = (s) => parseInt((s || "0").replace(/[^0-7]/g, "") || "0", 8) || 0;
              const strip = (n) => n.replace(/\/+$/, "");
              const extractTgz = (tgzBuf, dir) => {
                const tar = zlib.gunzipSync(tgzBuf);
                const BLOCK = 512;
                let off = 0;
                while (off + BLOCK <= tar.length) {
                  const h = tar.slice(off, off + BLOCK);
                  const name = h.toString("utf8", 0, 100).replace(/\0.*$/, "");
                  if (name === "") break;
                  const size = oct(h.toString("utf8", 124, 136));
                  const type = String.fromCharCode(h[156] || 0x30);
                  const dataStart = off + BLOCK;
                  if (type === "5") {
                    fs.mkdirSync(path.join(dir, strip(name)), { recursive: true });
                  } else if (type === "2") {
                    const target = path.join(dir, strip(name));
                    fs.mkdirSync(path.dirname(target), { recursive: true });
                    fs.writeFileSync(target, Buffer.alloc(0));
                  } else {
                    const target = path.join(dir, name);
                    fs.mkdirSync(path.dirname(target), { recursive: true });
                    fs.writeFileSync(target, tar.slice(dataStart, dataStart + size));
                  }
                  off = dataStart + Math.ceil(size / BLOCK) * BLOCK;
                }
              };
              const main = async () => {
                if (!base) return;
                try {
                  const state = readState();
                  const oldManaged = state.managed || {};
                  const res = await fetch(base + "/manifest", {
                    headers: { "If-None-Match": state.version || "", "Accept": "application/json" },
                    signal: AbortSignal.timeout(15000)
                  });
                  if (res.status === 304) return;
                  if (!res.ok) { log("manifest HTTP", res.status); return; }
                  const man = await res.json();
                  const skills = (man.skills || []).map(s => ({ name: s.name, sha256: s.sha256 }));
                  const newManaged = {};
                  fs.mkdirSync(dst, { recursive: true });
                  for (const s of skills) {
                    const skillDst = path.join(dst, s.name);
                    if (oldManaged[s.name] === s.sha256 && fs.existsSync(skillDst)) {
                      newManaged[s.name] = s.sha256;
                      continue;
                    }
                    const tmpTgz = path.join(dst, ".mfpi-tmp-" + s.name + ".tgz");
                    const tmpDir = path.join(dst, ".mfpi-tmp-" + s.name);
                    try {
                      const buf = Buffer.from(await (await fetch(base + "/" + s.name + ".tgz", { signal: AbortSignal.timeout(15000) })).arrayBuffer());
                      fs.writeFileSync(tmpTgz, buf);
                      fs.rmSync(tmpDir, { recursive: true, force: true });
                      fs.mkdirSync(tmpDir, { recursive: true });
                      extractTgz(buf, tmpDir);
                      fs.rmSync(skillDst, { recursive: true, force: true });
                      const inner = path.join(tmpDir, s.name);
                      if (fs.existsSync(inner)) {
                        fs.renameSync(inner, skillDst);
                      } else {
                        fs.renameSync(tmpDir, skillDst);
                      }
                      newManaged[s.name] = s.sha256;
                      log("installed", s.name, s.sha256);
                    } catch (e) {
                      log("install failed", s.name, String((e && e.message) || e));
                    } finally {
                      for (const f of [tmpTgz, tmpDir]) {
                        try { fs.rmSync(f, { recursive: true, force: true }); } catch (e2) {}
                      }
                    }
                  }
                  for (const name of Object.keys(oldManaged)) {
                    if (!newManaged[name]) {
                      fs.rmSync(path.join(dst, name), { recursive: true, force: true });
                      log("removed", name);
                    }
                  }
                  writeState({ version: man.version || "", managed: newManaged });
                } catch (e) {
                  log("error", String((e && e.message) || e));
                }
              };
              main();
            ' || true
          fi
          sleep 10
        done
      ) &

      # Recover project working directories. projects.json is persisted on the
      # PV, but a project's working directory itself may live outside
      # /data/pi-agent (e.g. /dtom2) and is therefore ephemeral: the pi agent
      # refuses to open a session whose stored cwd no longer exists. The actor
      # sandbox is normally restored from a snapshot (golden base or suspend
      # checkpoint), so a one-shot boot-time fix would never re-run; instead
      # run this as a background loop: the restored process continues after
      # every resume and re-creates any project directory that went missing.
      (
        while true; do
          # Durable default location for project workspaces: users who create
          # projects there (or under $HOME, now on the volume) keep their files
          # across an image update.
          mkdir -p /data/pi-agent/projects
          node -e '
            const fs = require("fs");
            try {
              const raw = fs.readFileSync(process.env.PI_WEB_DATA_DIR + "/projects.json", "utf8");
              const projects = (JSON.parse(raw).projects || []);
              const durableRoots = [
                process.env.PI_CODING_AGENT_DIR || "/data/pi-agent",
                process.env.HOME || "/data/pi-agent/home",
              ];
              for (const p of projects) {
                if (p && typeof p.path === "string" && p.path.startsWith("/")) {
                  const durable = durableRoots.some(
                    (root) => p.path === root || p.path.startsWith(root + "/"),
                  );
                  if (!durable) {
                    console.error(
                      "mf-pi: project cwd is outside the durable volume and will not survive an image update: " + p.path,
                    );
                  }
                  try { fs.mkdirSync(p.path, { recursive: true }); } catch (e) {
                    console.error("mf-pi: could not recreate project dir " + p.path + ": " + e.message);
                  }
                }
              }
            } catch (e) { /* no projects.json yet: nothing to recover */ }
          ' || true
          sleep 10
        done
      ) &

      sock=${PI_WEB_SESSIOND_SOCKET:-/data/pi-web/sessiond.sock}
      pi-web-sessiond &
      sessiond_pid=$!
      n=0
      until [ -S "$sock" ] || [ "$n" -ge 150 ]; do sleep 0.2; n=$((n+1)); done
      if [ ! -S "$sock" ]; then
        echo "mf-pi: sessiond socket did not appear at $sock" >&2
        kill "$sessiond_pid" 2>/dev/null || true
        exit 1
      fi
      pi-web-server &
      web_pid=$!

      term() {
        kill -TERM "$web_pid" "$sessiond_pid" 2>/dev/null || true
      }
      trap term TERM INT
      set +e
      wait "$web_pid"
      web_status=$?
      term
      wait "$sessiond_pid" 2>/dev/null
      exit "$web_status"

    volumeMounts:
    - name: userdata
      mountPath: /data/pi-agent
    env:
    # atenet-router forwards traffic to the actor on port 80.
    - name: PI_WEB_PORT
      value: "80"
    - name: PI_WEB_HOST
      value: "0.0.0.0"
    # The Docker host-bridge features (docker.sock, host paths) do not apply
    # to actor sandboxes.
    - name: HOSTEXEC_MODE
      value: disabled
    # Persist pi-web's data directory AND sessiond socket on the userdata PV
    # (mounted at /data/pi-agent): a delete+recreate redeploy (image refresh)
    # then keeps user data. PI_WEB_SESSIOND_SOCKET must match the path the
    # supervisor waits on (see the args block's `sock=` default).
    - name: PI_WEB_DATA_DIR
      value: /data/pi-agent
    - name: PI_WEB_SESSIOND_SOCKET
      value: /data/pi-agent/sessiond.sock
    # Durable user state: HOME and XDG_CONFIG_HOME are redirected onto the
    # userdata PV so that everything pi-web installs into the user's home —
    # most importantly user-scope Pi packages/skills under $HOME/.pi/packages
    # (POST /api/pi-packages/install) — survives an actor image update
    # (delete + recreate). Anything outside /data/pi-agent is ephemeral.
    - name: HOME
      value: /data/pi-agent/home
    - name: XDG_CONFIG_HOME
      value: /data/pi-agent/config
    # Deploy revision stamp (harmless to the app). deploy-test.sh renders it
    # from MFPI_DEPLOY_REV (default "0"); test-image-update-persistence.sh
    # bumps it to force a real ActorTemplate spec change, exercising the
    # template-replace -> refresh-existing-users -> golden-snapshot path.
    - name: PI_WEB_DEPLOY_REV
      value: "${MFPI_DEPLOY_REV}"
    # Base of the admin's read-only /internal/skills API. The supervisor's
    # managed-skills loop syncs administrator-provisioned skills from here.
    # Do NOT prefix with MFPI_ (validate-templates.sh asserts on that).
    - name: PI_WEB_SKILLS_URL
      value: http://mfpi-admin.ate-demo-mf-pi-test.svc.cluster.local:8080/internal/skills
    # Admin endpoint serving the operator-managed provider registry
    # (models.json); see admin/providermodels.go.
    - name: PI_WEB_MODELS_URL
      value: http://mfpi-admin.ate-demo-mf-pi-test.svc.cluster.local:8080/internal/providers/models.json
    - name: DEEPSEEK_API_KEY
      valueFrom:
        secretKeyRef:
          name: mf-pi-provider-config
          key: DEEPSEEK_API_KEY
  volumes:
  - name: userdata
    externalVolumeTemplate:
      capacity: 5Gi
      storageClassName: standard
  workerSelector:
    matchLabels:
      workload: mf-pi-test
  snapshotsConfig:
    # Full snapshots (process memory + filesystem delta). The userdata
    # external volume is not part of the rootfs delta: user data persists on
    # the node via the sticky volume and survives delete+recreate redeploys
    # (see docs/save_userdata_pv.md).
    # snapshots live under a distinct prefix so they never collide with prod.
    onPause: Full
    onCommit: Full
    location: gs://${BUCKET_NAME}/ate-demo-mf-pi-test/

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: mf-pi-small
