# pi-web deployed as an actor (the mf-pi demo) — TEST environment.
#
# This is the test-environment counterpart of mf-pi.yaml.tmpl. It deploys into
# the ate-demo-mf-pi-test namespace, uses the mfpi-test atespace, a distinct
# worker label (workload=mf-pi-test) and a separate snapshot path so it never
# collides with the production environment. Pause and workload images are
# pinned by digest and must be pushed to ${KO_DOCKER_REPO} (localhost:5001 in
# a kind environment) — the cluster nodes cannot reach external registries.
#
# See mf-pi.yaml.tmpl for why only `args` is set (the image's ENTRYPOINT
# tini -- pi-web-bootstrap is preserved and execs the sessiond+web supervisor).

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-mf-pi-test

---

apiVersion: v1
kind: Secret
metadata:
  name: mf-pi-provider-config
  namespace: ate-demo-mf-pi-test
type: Opaque
stringData:
  # pi-web's built-in deepseek provider picks this up (model picker:
  # deepseek/deepseek-chat or deepseek/deepseek-reasoner).
  DEEPSEEK_API_KEY: "${DEEPSEEK_API_KEY}"

---

# Grant ate-api-server read access to the Secrets that this demo's
# ActorTemplate references (env resolution + volume resolution).
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ate-api-server-env-sources
  namespace: ate-demo-mf-pi-test
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["mf-pi-provider-config"]
  verbs: ["get"]
- apiGroups: [""]
  resources: ["secrets"]
  # The ActorTemplate's objectStoreBucket volume resolves its endpoint and
  # credentials from the mfpi-minio-admin Secret (see mount_minio_v2.md).
  resourceNames: ["mfpi-minio-admin"]
  verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ate-api-server-env-sources
  namespace: ate-demo-mf-pi-test
subjects:
- kind: ServiceAccount
  name: ate-api-server
  namespace: ate-system
roleRef:
  kind: Role
  name: ate-api-server-env-sources
  apiGroup: rbac.authorization.k8s.io
---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: mf-pi-workerpool
  namespace: ate-demo-mf-pi-test
  labels:
    # Distinct worker label from prod (workload=mf-pi): scheduling matches
    # workers by label across the whole cluster, so this keeps test actors on
    # test workers and prod actors on prod workers.
    workload: mf-pi-test
spec:
  # Number of physical workers; bounds the max number of concurrently-active
  # (non-suspended) users. Configurable via ${MFPI_WORKER_REPLICAS} (default 2).
  replicas: ${MFPI_WORKER_REPLICAS}
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: mf-pi
  namespace: ate-demo-mf-pi-test
spec:
  pauseImage: "localhost:5001/pause:3.10.2@${PAUSE_DIGEST}"
  containers:
  - name: pi-web
    image: "localhost:5001/pi-web@${MF_PI_DIGEST}"
    # Only `args` is set (no `command`), so the image's ENTRYPOINT
    # (tini -- /usr/local/bin/pi-web-bootstrap) is preserved: the bootstrap
    # installs the baked-in skills into /data/pi-agent/skills on first start
    # (seeding an empty bucket volume) and then execs this single-container
    # supervisor, which starts pi-web-sessiond, waits for its unix socket,
    # and runs pi-web-server on port 80 (see docker/scripts/run-container.sh
    # in the pi-web repo for the same single-container supervisor shape).
    volumeMounts:
    # /data/pi-agent is backed by the user's MinIO bucket through the
    # objectStoreBucket volume below (see mount_minio_v2.md): the agent
    # writes user data directly to the mounted path, atelet rehydrates the
    # bucket into an empty mount automatically (e.g. after a delete+recreate
    # reset) and keeps the bucket in sync — so no in-image sync logic exists.
    - name: pi-agent-data
      mountPath: /data/pi-agent
    args:
    - sh
    - -c
    - |
      set -eu
      # Single-container supervisor: start pi-web-sessiond, wait for its unix
      # socket, then run pi-web-server on $PI_WEB_PORT.
      sock=${PI_WEB_SESSIOND_SOCKET:-/data/pi-web/sessiond.sock}
      pi-web-sessiond &
      sessiond_pid=$!
      n=0
      until [ -S "$sock" ] || [ "$n" -ge 150 ]; do sleep 0.2; n=$((n+1)); done
      if [ ! -S "$sock" ]; then
        echo "mf-pi: sessiond socket did not appear at $sock" >&2
        kill "$sessiond_pid" 2>/dev/null || true
        exit 1
      fi
      pi-web-server &
      web_pid=$!
      term() {
        kill -TERM "$web_pid" "$sessiond_pid" 2>/dev/null || true
      }
      trap term TERM INT
      set +e
      wait "$web_pid"
      web_status=$?
      term
      wait "$sessiond_pid" 2>/dev/null
      exit "$web_status"

    env:
    # atenet-router forwards traffic to the actor on port 80.
    - name: PI_WEB_PORT
      value: "80"
    - name: PI_WEB_HOST
      value: "0.0.0.0"
    # The Docker host-bridge features (docker.sock, host paths) do not apply
    # to actor sandboxes.
    - name: HOSTEXEC_MODE
      value: disabled
    - name: DEEPSEEK_API_KEY
      valueFrom:
        secretKeyRef:
          name: mf-pi-provider-config
          key: DEEPSEEK_API_KEY
  # Per-user MinIO bucket backing /data/pi-agent (see mount_minio_v2.md).
  # The bucket name is the actor's name (no bucketPrefix), matching the
  # mfpi-admin badge. Resolution reads endpoint/credentials from the
  # mfpi-minio-admin Secret in this namespace; ateapi threads the resolved
  # values to atelet, which mounts the volume and syncs it with the bucket.
  volumes:
  - name: pi-agent-data
    objectStoreBucket:
      secretRef:
        name: mfpi-minio-admin
        endpointKey: endpoint
        accessKeyIdKey: root-user
        secretAccessKeyKey: root-password
  workerSelector:
    matchLabels:
      workload: mf-pi-test
  snapshotsConfig:
    # Full snapshots: the objectStoreBucket volume is excluded from the
    # filesystem delta (its truth is the MinIO bucket), and Data snapshots
    # require a durableDir volume, so we use Full (process memory + the rest
    # of the filesystem delta). Test snapshots live under a distinct prefix
    # so they never collide with prod.
    onPause: Full
    onCommit: Full
    location: gs://${BUCKET_NAME}/ate-demo-mf-pi-test/

---

# ConfigMap holding per-user access passwords (username -> hash). Pre-created
# here (empty) so the mfpi-admin server only needs get/update — RBAC cannot
# name-restrict the `create` verb, so the server never creates it itself.
apiVersion: v1
kind: ConfigMap
metadata:
  name: mfpi-user-passwords
  namespace: ate-demo-mf-pi-test
---
# ServiceAccount + RBAC for the mfpi-admin server to read/write the
# mfpi-user-passwords ConfigMap. The projected ateapi-token volume below is
# separate and still used for ateapi auth.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: mfpi-admin
  namespace: ate-demo-mf-pi-test
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: mfpi-admin-passwords
  namespace: ate-demo-mf-pi-test
rules:
- apiGroups: [""]
  resources: ["configmaps"]
  resourceNames: ["mfpi-user-passwords"]
  verbs: ["get", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: mfpi-admin-passwords
  namespace: ate-demo-mf-pi-test
subjects:
- kind: ServiceAccount
  name: mfpi-admin
  namespace: ate-demo-mf-pi-test
roleRef:
  kind: Role
  name: mfpi-admin-passwords
  apiGroup: rbac.authorization.k8s.io
---
# Pre-created empty Secret holding per-user DeepSeek provider keys
# (username -> key). Pre-created here (empty) so the mfpi-admin server only
# needs get/update — RBAC cannot name-restrict the `create` verb, so the
# server never creates it itself. Managed by the admin server (see
# admin/apikey.go, env KEYS_SECRET).
apiVersion: v1
kind: Secret
metadata:
  name: mfpi-user-provider-keys
  namespace: ate-demo-mf-pi-test
type: Opaque
---
# Role/RoleBinding: let the mfpi-admin SA read/update the per-user key Secret.
# (The ate-api-server-env-sources Role above is separate; do not merge.)
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: mfpi-admin-keys
  namespace: ate-demo-mf-pi-test
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["mfpi-user-provider-keys"]
  verbs: ["get", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: mfpi-admin-keys
  namespace: ate-demo-mf-pi-test
subjects:
- kind: ServiceAccount
  name: mfpi-admin
  namespace: ate-demo-mf-pi-test
roleRef:
  kind: Role
  name: mfpi-admin-keys
  apiGroup: rbac.authorization.k8s.io
---

# MinIO object store dedicated to mf-pi user data (TEST). Each user (one user
# == one Actor running pi-web) gets their own bucket inside this store; the
# platform (ateapi resolves the volume Secret, atelet syncs) mounts the bucket
# into the actor at /data/pi-agent via the objectStoreBucket volume, and the
# mfpi-admin server reads it for the user-list "已同步" badge. The single
# central admin credential lives in mfpi-minio-admin below: actors never see
# MinIO credentials (atelet receives them per-RPC from ateapi). This store is
# intentionally namespaced per demo environment (prod vs test never share
# buckets).
apiVersion: v1
kind: Secret
metadata:
  name: mfpi-minio-admin
  namespace: ate-demo-mf-pi-test
type: Opaque
stringData:
  # S3 endpoint of this MinIO. Read by ate-api-server when resolving the
  # ActorTemplate's objectStoreBucket volume secretRef (see the RBAC Role
  # above).
  endpoint: "http://mfpi-minio.ate-demo-mf-pi-test.svc:9000"
  # Local demo root credentials (overridable via deploy-test.sh). MinIO is not
  # exposed outside the cluster, and mfpi-minio has no external Service.
  root-user: "${MINIO_ROOT_USER}"
  root-password: "${MINIO_ROOT_PASSWORD}"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: mfpi-minio-data
  namespace: ate-demo-mf-pi-test
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 10Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mfpi-minio
  namespace: ate-demo-mf-pi-test
  labels:
    app: mfpi-minio
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mfpi-minio
  template:
    metadata:
      labels:
        app: mfpi-minio
    spec:
      containers:
      - name: minio
        image: "localhost:5001/minio@${MINIO_DIGEST}"
        args: ["server", "/data", "--console-address", ":9001"]
        env:
        - name: MINIO_ROOT_USER
          valueFrom:
            secretKeyRef:
              name: mfpi-minio-admin
              key: root-user
        - name: MINIO_ROOT_PASSWORD
          valueFrom:
            secretKeyRef:
              name: mfpi-minio-admin
              key: root-password
        ports:
        - containerPort: 9000
          name: s3
        volumeMounts:
        - name: data
          mountPath: /data
        readinessProbe:
          httpGet:
            path: /minio/health/ready
            port: 9000
          initialDelaySeconds: 5
          periodSeconds: 5
        livenessProbe:
          httpGet:
            path: /minio/health/live
            port: 9000
          initialDelaySeconds: 10
          periodSeconds: 10
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: mfpi-minio-data
---
apiVersion: v1
kind: Service
metadata:
  name: mfpi-minio
  namespace: ate-demo-mf-pi-test
spec:
  selector:
    app: mfpi-minio
  ports:
  - name: s3
    port: 9000
    targetPort: 9000

---

# mf-pi user-management UI (TEST). Served through the mfpi-nginx-test proxy
# at /usermanagement/; same in-cluster auth pattern as production. Holds the
# MinIO admin credential (env below) for the user-list "已同步" badge
# (HeadObject; the bucket sync itself is atelet's objectStoreBucket volume
# job).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mfpi-admin
  namespace: ate-demo-mf-pi-test
  labels:
    app: mfpi-admin
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mfpi-admin
  template:
    metadata:
      labels:
        app: mfpi-admin
    spec:
      serviceAccountName: mfpi-admin
      containers:
      - name: mfpi-admin
        image: ko://github.com/agent-substrate/substrate/demos/mf-pi/admin
        ports:
        - containerPort: 8080
        env:
        - name: ATESPACE
          value: mfpi-test
        - name: ACTOR_TEMPLATE_NAMESPACE
          value: ate-demo-mf-pi-test
        - name: ACTOR_TEMPLATE_NAME
          value: mf-pi
        - name: ATEAPI_ADDR
          value: dns:///api.ate-system.svc:443
        - name: ATEAPI_CA_FILE
          value: /run/servicedns-ca/trust-bundle.pem
        - name: ATEAPI_TOKEN_FILE
          value: /run/ateapi-token/token
        - name: PASSWORDS_CONFIGMAP
          value: mfpi-user-passwords
        - name: PASSWORDS_NAMESPACE
          value: ate-demo-mf-pi-test
        - name: KEYS_SECRET
          value: mfpi-user-provider-keys
        - name: KEYS_NAMESPACE
          value: ate-demo-mf-pi-test
        - name: ROUTER_ADDR
          value: http://atenet-router.ate-system.svc:80
        # Per-user MinIO profile persistence: the admin only READS the bucket
        # for the user-list badge; the sync is atelet's objectStoreBucket
        # volume job (see mount_minio_v2.md).
        - name: MINIO_ENDPOINT
          value: http://mfpi-minio.ate-demo-mf-pi-test.svc:9000
        - name: MINIO_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              name: mfpi-minio-admin
              key: root-user
        - name: MINIO_SECRET_KEY
          valueFrom:
            secretKeyRef:
              name: mfpi-minio-admin
              key: root-password
        - name: MINIO_REGION
          value: us-east-1
        volumeMounts:
        - name: ateapi-token
          mountPath: /run/ateapi-token
          readOnly: true
        - name: servicedns-ca
          mountPath: /run/servicedns-ca
          readOnly: true
      volumes:
      - name: ateapi-token
        projected:
          sources:
          - serviceAccountToken:
              audience: api.ate-system.svc
              expirationSeconds: 3600
              path: token
      - name: servicedns-ca
        projected:
          sources:
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: trust-bundle.pem

---

apiVersion: v1
kind: Service
metadata:
  name: mfpi-admin
  namespace: ate-demo-mf-pi-test
spec:
  selector:
    app: mfpi-admin
  ports:
  - port: 8080
    targetPort: 8080
