        kill "$sessiond_pid" 2>/dev/null || true
        exit 1
      fi
      pi-web-server &
      web_pid=$!

      term() {
        kill -TERM "$web_pid" "$sessiond_pid" 2>/dev/null || true
      }
      trap term TERM INT
      set +e
      wait "$web_pid"
      web_status=$?
      term
      wait "$sessiond_pid" 2>/dev/null
      exit "$web_status"

    volumeMounts:
    - name: userdata
      mountPath: /data/pi-agent
    env:
    # atenet-router forwards traffic to the actor on port 80.
    - name: PI_WEB_PORT
      value: "80"
    - name: PI_WEB_HOST
      value: "0.0.0.0"
    # The Docker host-bridge features (docker.sock, host paths) do not apply
    # to actor sandboxes.
    - name: HOSTEXEC_MODE
      value: disabled
    # Persist pi-web's data directory AND sessiond socket on the userdata PV
    # (mounted at /data/pi-agent): a delete+recreate redeploy (image refresh)
    # then keeps user data. PI_WEB_SESSIOND_SOCKET must match the path the
    # supervisor waits on (see the args block's `sock=` default).
    - name: PI_WEB_DATA_DIR
      value: /data/pi-agent
    - name: PI_WEB_SESSIOND_SOCKET
      value: /data/pi-agent/sessiond.sock
    - name: DEEPSEEK_API_KEY
      valueFrom:
        secretKeyRef:
          name: mf-pi-provider-config
          key: DEEPSEEK_API_KEY
  volumes:
  - name: userdata
    externalVolumeTemplate:
      capacity: 50Gi
      storageClassName: standard
  workerSelector:
    matchLabels:
      workload: mf-pi-large
  snapshotsConfig:
    # Full snapshots (process memory + filesystem delta). The userdata
    # external volume is not part of the rootfs delta: user data persists on
    # the node via the sticky volume and survives delete+recreate redeploys
    # (see save_userdata_pv.md).
    onPause: Full
    onCommit: Full
    location: gs://${BUCKET_NAME}/ate-demo-mf-pi/
---

# ConfigMap holding per-user access passwords (username -> hash). Pre-created
# here (empty) so the mfpi-admin server only needs get/update — RBAC cannot
# name-restrict the `create` verb, so the server never creates it itself.
apiVersion: v1
kind: ConfigMap
metadata:
  name: mfpi-user-passwords
  namespace: ate-demo-mf-pi
---
# ConfigMap holding per-user activation expiries (username -> RFC3339 expiry
# timestamp). Same pre-created + get/update RBAC pattern as the passwords
# ConfigMap (see admin/expiry.go, env EXPIRY_CONFIGMAP).
apiVersion: v1
kind: ConfigMap
metadata:
  name: mfpi-user-expirations
  namespace: ate-demo-mf-pi
---
# ConfigMap holding per-user resource tiers (username -> tier name, e.g.
# small/mid/large). Same pre-created + get/update RBAC pattern (see
# admin/tier.go, env TIERS_CONFIGMAP).
apiVersion: v1
kind: ConfigMap
metadata:
  name: mfpi-user-tiers
  namespace: ate-demo-mf-pi
---
# ServiceAccount + RBAC for the mfpi-admin server to read/write the
# mfpi-user-passwords ConfigMap. The projected ateapi-token volume below is
# separate and still used for ateapi auth.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: mfpi-admin
  namespace: ate-demo-mf-pi
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: mfpi-admin-passwords
  namespace: ate-demo-mf-pi
rules:
- apiGroups: [""]
  resources: ["configmaps"]
  resourceNames: ["mfpi-user-passwords"]
  verbs: ["get", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: mfpi-admin-passwords
  namespace: ate-demo-mf-pi
subjects:
- kind: ServiceAccount
  name: mfpi-admin
  namespace: ate-demo-mf-pi
roleRef:
  kind: Role
  name: mfpi-admin-passwords
  apiGroup: rbac.authorization.k8s.io
# Role/RoleBinding: let the mfpi-admin SA read/update the expirations ConfigMap.
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: mfpi-admin-expirations
  namespace: ate-demo-mf-pi
rules:
- apiGroups: [""]
  resources: ["configmaps"]
  resourceNames: ["mfpi-user-expirations"]
  verbs: ["get", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: mfpi-admin-expirations
  namespace: ate-demo-mf-pi
subjects:
- kind: ServiceAccount
  name: mfpi-admin
  namespace: ate-demo-mf-pi
roleRef:
  kind: Role
  name: mfpi-admin-expirations
  apiGroup: rbac.authorization.k8s.io
# Role/RoleBinding: let the mfpi-admin SA read/update the tiers ConfigMap.
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: mfpi-admin-tiers
  namespace: ate-demo-mf-pi
rules:
- apiGroups: [""]
  resources: ["configmaps"]
  resourceNames: ["mfpi-user-tiers"]
  verbs: ["get", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: mfpi-admin-tiers
  namespace: ate-demo-mf-pi
subjects:
- kind: ServiceAccount
  name: mfpi-admin
  namespace: ate-demo-mf-pi
roleRef:
  kind: Role
  name: mfpi-admin-tiers
  apiGroup: rbac.authorization.k8s.io
---
# Pre-created empty Secret holding per-user DeepSeek provider keys
# (username -> key). Pre-created here (empty) so the mfpi-admin server only
# needs get/update — RBAC cannot name-restrict the `create` verb, so the
# server never creates it itself. Managed by the admin server (see
# admin/apikey.go, env KEYS_SECRET).
apiVersion: v1
kind: Secret
metadata:
  name: mfpi-user-provider-keys
  namespace: ate-demo-mf-pi
type: Opaque
---
# Role/RoleBinding: let the mfpi-admin SA read/update the per-user key Secret.
# (The ate-api-server-env-sources Role above is separate; do not merge.)
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: mfpi-admin-keys
  namespace: ate-demo-mf-pi
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["mfpi-user-provider-keys"]
  verbs: ["get", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: mfpi-admin-keys
  namespace: ate-demo-mf-pi
subjects:
- kind: ServiceAccount
  name: mfpi-admin
  namespace: ate-demo-mf-pi
roleRef:
  kind: Role
  name: mfpi-admin-keys
  apiGroup: rbac.authorization.k8s.io
---

# mf-pi user-management UI. A tiny Go HTTP server that proxies to the
# ateapi Control gRPC service to list/create/delete users (each user is one
# Actor in the mfpi atespace). It is served through the mfpi-nginx proxy at
# /usermanagement/. It authenticates in-cluster with a projected SA token
# (audience api.ate-system.svc) and trusts the servicedns ClusterTrustBundle
# for the ateapi serving cert. It runs as the mfpi-admin SA, which additionally
# has RBAC for the mfpi-user-passwords / mfpi-user-expirations /
# mfpi-user-tiers ConfigMaps and the per-user key Secret.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mfpi-admin
  namespace: ate-demo-mf-pi
  labels:
    app: mfpi-admin
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mfpi-admin
  template:
    metadata:
      labels:
        app: mfpi-admin
    spec:
      serviceAccountName: mfpi-admin
      containers:
      - name: mfpi-admin
        image: ko://github.com/agent-substrate/substrate/demos/mf-pi/admin
        ports:
        - containerPort: 8080
        env:
        - name: ATESPACE
          value: mfpi
        - name: ACTOR_TEMPLATE_NAMESPACE
          value: ate-demo-mf-pi
        - name: ACTOR_TEMPLATE_NAME
          value: mf-pi
        - name: ATEAPI_ADDR
          value: dns:///api.ate-system.svc:443
        - name: ATEAPI_CA_FILE
          value: /run/servicedns-ca/trust-bundle.pem
        - name: ATEAPI_TOKEN_FILE
          value: /run/ateapi-token/token
        - name: PASSWORDS_CONFIGMAP
          value: mfpi-user-passwords
        - name: PASSWORDS_NAMESPACE
          value: ate-demo-mf-pi
        - name: KEYS_SECRET
          value: mfpi-user-provider-keys
        - name: KEYS_NAMESPACE
          value: ate-demo-mf-pi
        - name: EXPIRY_CONFIGMAP
          value: mfpi-user-expirations
        - name: EXPIRY_NAMESPACE
          value: ate-demo-mf-pi
        - name: TIERS_CONFIGMAP
          value: mfpi-user-tiers
        - name: TIERS_NAMESPACE
          value: ate-demo-mf-pi
        - name: DEFAULT_TIER
          value: small
        - name: ROUTER_ADDR
          value: http://atenet-router.ate-system.svc:80
        volumeMounts:
        - name: ateapi-token
          mountPath: /run/ateapi-token
          readOnly: true
        - name: servicedns-ca
          mountPath: /run/servicedns-ca
          readOnly: true
      volumes:
      - name: ateapi-token
        projected:
          sources:
          - serviceAccountToken:
              audience: api.ate-system.svc
              expirationSeconds: 3600
              path: token
      - name: servicedns-ca
        projected:
          sources:
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: trust-bundle.pem
---

apiVersion: v1
kind: Service
metadata:
  name: mfpi-admin
  namespace: ate-demo-mf-pi
spec:
  selector:
    app: mfpi-admin
  ports:
  - port: 8080
    targetPort: 8080
