# cc-haha (mf-cc) Web UI deployed as an actor. The container listens on
# port 80 (atenet-router forwards all traffic there). Pause and workload
# images are pinned by digest and must be pushed to ${KO_DOCKER_REPO}
# (localhost:5001 in a kind environment) — the cluster nodes cannot reach
# external registries.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-mf-cc

---

apiVersion: v1
kind: Secret
metadata:
  name: mf-cc-provider-config
  namespace: ate-demo-mf-cc
type: Opaque
stringData:
  ANTHROPIC_AUTH_TOKEN: "${ANTHROPIC_AUTH_TOKEN}"
  ANTHROPIC_BASE_URL: "${ANTHROPIC_BASE_URL}"
  ANTHROPIC_MODEL: "${ANTHROPIC_MODEL}"

---

# Grant ate-api-server read access to the Secret that this demo's
# ActorTemplate references for env resolution.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ate-api-server-env-sources
  namespace: ate-demo-mf-cc
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["mf-cc-provider-config"]
  verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ate-api-server-env-sources
  namespace: ate-demo-mf-cc
subjects:
- kind: ServiceAccount
  name: ate-api-server
  namespace: ate-system
roleRef:
  kind: Role
  name: ate-api-server-env-sources
  apiGroup: rbac.authorization.k8s.io
---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: mf-cc-workerpool
  namespace: ate-demo-mf-cc
  labels:
    workload: mf-cc
spec:
  # Number of physical workers; bounds the max number of concurrently-active
  # (non-suspended) users. Configurable via ${MFCC_WORKER_REPLICAS} (default 4).
  replicas: ${MFCC_WORKER_REPLICAS}
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: mf-cc
  namespace: ate-demo-mf-cc
spec:
  pauseImage: "localhost:5001/pause:3.10.2@${PAUSE_DIGEST}"
  containers:
  - name: mf-cc
    image: "localhost:5001/mf-cc@${MFCC_DIGEST}"
    # Substrate runs actor containers with Cwd "/" (the image's WORKDIR /app
    # is ignored), so the entrypoint must use absolute paths.
    command:
    - /usr/local/bin/bun
    - run
    - /app/src/server/index.ts
    env:
    # atenet-router forwards traffic to the actor on port 80.
    - name: SERVER_PORT
      value: "80"
    - name: SERVER_HOST
      value: "0.0.0.0"
    - name: CLAUDE_H5_ALLOW_ALL_ORIGINS
      value: "1"
    - name: CLAUDE_CONFIG_DIR
      value: /root/.claude
    - name: ANTHROPIC_AUTH_TOKEN
      valueFrom:
        secretKeyRef:
          name: mf-cc-provider-config
          key: ANTHROPIC_AUTH_TOKEN
    - name: ANTHROPIC_BASE_URL
      valueFrom:
        secretKeyRef:
          name: mf-cc-provider-config
          key: ANTHROPIC_BASE_URL
    - name: ANTHROPIC_MODEL
      valueFrom:
        secretKeyRef:
          name: mf-cc-provider-config
          key: ANTHROPIC_MODEL
  workerSelector:
    matchLabels:
      workload: mf-cc
  snapshotsConfig:
    # Full snapshots: this demo no longer mounts a durableDir volume, and Data
    # snapshots require one, so we use Full (process memory + filesystem delta).
    # A full snapshot on pause is slower but needs no durableDir.
    onPause: Full
    onCommit: Full
    location: gs://${BUCKET_NAME}/ate-demo-mf-cc/

---

# ConfigMap holding per-user access passwords (username -> hash). Pre-created
# here (empty) so the mfcc-admin server only needs get/update — RBAC cannot
# name-restrict the `create` verb, so the server never creates it itself.
apiVersion: v1
kind: ConfigMap
metadata:
  name: mfcc-user-passwords
  namespace: ate-demo-mf-cc
---
# ServiceAccount + RBAC for the mfcc-admin server to read/write the
# mfcc-user-passwords ConfigMap. The projected ateapi-token volume below is
# separate and still used for ateapi auth.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: mfcc-admin
  namespace: ate-demo-mf-cc
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: mfcc-admin-passwords
  namespace: ate-demo-mf-cc
rules:
- apiGroups: [""]
  resources: ["configmaps"]
  resourceNames: ["mfcc-user-passwords"]
  verbs: ["get", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: mfcc-admin-passwords
  namespace: ate-demo-mf-cc
subjects:
- kind: ServiceAccount
  name: mfcc-admin
  namespace: ate-demo-mf-cc
roleRef:
  kind: Role
  name: mfcc-admin-passwords
  apiGroup: rbac.authorization.k8s.io
---

# mf-cc user-management UI. A tiny Go HTTP server that proxies to the
# ateapi Control gRPC service to list/create/delete users (each user is one
# Actor in the mfcc atespace). It is served through the mfcc-nginx proxy at
# /usermanagement/. It authenticates in-cluster with a projected SA token
# (audience api.ate-system.svc) and trusts the servicedns ClusterTrustBundle
# for the ateapi serving cert. It runs as the mfcc-admin SA, which additionally
# has RBAC for the mfcc-user-passwords ConfigMap.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mfcc-admin
  namespace: ate-demo-mf-cc
  labels:
    app: mfcc-admin
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mfcc-admin
  template:
    metadata:
      labels:
        app: mfcc-admin
    spec:
      serviceAccountName: mfcc-admin
      containers:
      - name: mfcc-admin
        image: ko://github.com/agent-substrate/substrate/demos/mf-cc/admin
        ports:
        - containerPort: 8080
        env:
        - name: ATESPACE
          value: mfcc
        - name: ACTOR_TEMPLATE_NAMESPACE
          value: ate-demo-mf-cc
        - name: ACTOR_TEMPLATE_NAME
          value: mf-cc
        - name: ATEAPI_ADDR
          value: dns:///api.ate-system.svc:443
        - name: ATEAPI_CA_FILE
          value: /run/servicedns-ca/trust-bundle.pem
        - name: ATEAPI_TOKEN_FILE
          value: /run/ateapi-token/token
        - name: PASSWORDS_CONFIGMAP
          value: mfcc-user-passwords
        - name: PASSWORDS_NAMESPACE
          value: ate-demo-mf-cc
        volumeMounts:
        - name: ateapi-token
          mountPath: /run/ateapi-token
          readOnly: true
        - name: servicedns-ca
          mountPath: /run/servicedns-ca
          readOnly: true
      volumes:
      - name: ateapi-token
        projected:
          sources:
          - serviceAccountToken:
              audience: api.ate-system.svc
              expirationSeconds: 3600
              path: token
      - name: servicedns-ca
        projected:
          sources:
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: trust-bundle.pem

---

apiVersion: v1
kind: Service
metadata:
  name: mfcc-admin
  namespace: ate-demo-mf-cc
spec:
  selector:
    app: mfcc-admin
  ports:
  - port: 8080
    targetPort: 8080
